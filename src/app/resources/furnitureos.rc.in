// Windows version resource for the FurnitureOS desktop application.
// SPDX-License-Identifier: AGPL-3.0-only
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FurnitureOS contributors"
            VALUE "FileDescription",  "@FOS_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@FOS_RC_NAME@"
            VALUE "LegalCopyright",   "Licensed under the GNU AGPL-3.0-only"
            VALUE "OriginalFilename", "@FOS_RC_NAME@.exe"
            VALUE "ProductName",      "FurnitureOS"
            VALUE "ProductVersion",   "@FOS_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
