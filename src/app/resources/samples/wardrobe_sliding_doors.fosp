        "parameters": [
          {
            "name": "back_engagement",
            "kind": "Length",
            "expression": "groove_depth - groove_clearance",
            "description": "Depth by which a grooved back enters each groove",
            "integer": false
          },
          {
            "name": "back_height",
            "kind": "Length",
            "expression": "carcass_height - 2 * back_inset",
            "description": "Back panel size along the cabinet height",
            "integer": false
          },
          {
            "name": "back_inset",
            "kind": "Length",
            "value": 2.0,
            "description": "Overlay back: inset from the outer carcass edges",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "back_rear_y",
            "kind": "Length",
            "expression": "depth + back_thickness",
            "description": "Depth coordinate of the rear face of the back panel",
            "integer": false
          },
          {
            "name": "back_thickness",
            "kind": "Length",
            "value": 3.0,
            "description": "Back panel thickness (synchronised from the back material)",
            "lowerBound": 0.1,
            "integer": false
          },
          {
            "name": "back_width",
            "kind": "Length",
            "expression": "width - 2 * back_inset",
            "description": "Back panel size along the cabinet width",
            "integer": false
          },
          {
            "name": "back_x",
            "kind": "Length",
            "expression": "back_inset",
            "description": "Left edge of the back panel",
            "integer": false
          },
          {
            "name": "back_z",
            "kind": "Length",
            "expression": "carcass_bottom + back_inset",
            "description": "Lower edge of the back panel",
            "integer": false
          },
          {
            "name": "bottom_length",
            "kind": "Length",
            "expression": "inner_width",
            "description": "Length of the bottom panel",
            "integer": false
          },
          {
            "name": "bottom_x",
            "kind": "Length",
            "expression": "thickness",
            "description": "Left end of the bottom panel",
            "integer": false
          },
          {
            "name": "carcass_bottom",
            "kind": "Length",
            "expression": "plinth_height",
            "description": "Height of the underside of the bottom panel",
            "integer": false
          },
          {
            "name": "carcass_height",
            "kind": "Length",
            "expression": "height - carcass_bottom",
            "description": "Height of the carcass box",
            "integer": false
          },
          {
            "name": "depth",
            "kind": "Length",
            "value": 650.0,
            "description": "Carcass depth (front edge to rear edge of the sides)",
            "lowerBound": 1.0,
            "integer": false
          },
          {
            "name": "front_gap",
            "kind": "Length",
            "value": 3.0,
            "description": "Gap between two adjacent fronts",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "front_offset",
            "kind": "Length",
            "value": 2.0,
            "description": "Gap between the carcass front and the inner face of overlay fronts",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "front_reveal",
            "kind": "Length",
            "value": 2.0,
            "description": "Full overlay: front edge inside the outer cabinet envelope",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "front_thickness",
            "kind": "Length",
            "value": 18.0,
            "description": "Front thickness (synchronised from the front material)",
            "lowerBound": 1.0,
            "integer": false
          },
          {
            "name": "groove_center",
            "kind": "Length",
            "expression": "depth - groove_distance - back_thickness / 2",
            "description": "Depth coordinate of the back groove centre line",
            "integer": false
          },
          {
            "name": "groove_clearance",
            "kind": "Length",
            "value": 1.0,
            "description": "Grooved back: clearance between each back edge and the groove bottom",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "groove_depth",
            "kind": "Length",
            "value": 8.0,
            "description": "Grooved back: groove depth",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "groove_distance",
            "kind": "Length",
            "value": 10.0,
            "description": "Grooved back: rear face of the back panel in front of the rear carcass edge",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "groove_fit",
            "kind": "Length",
            "value": 0.0,
            "description": "Grooved back: groove width in excess of the back thickness",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "groove_width",
            "kind": "Length",
