            "integer": false
          },
          {
            "name": "interior_bottom",
            "kind": "Length",
            "expression": "carcass_bottom + thickness",
            "description": "Height of the upper face of the bottom panel",
            "integer": false
          },
          {
            "name": "interior_depth",
            "kind": "Length",
            "expression": "depth",
            "description": "Usable depth in front of the back panel",
            "integer": false
          },
          {
            "name": "interior_top",
            "kind": "Length",
            "expression": "height - thickness",
            "description": "Height of the underside of the top panel / rails",
            "integer": false
          },
          {
            "name": "joint_end_offset",
            "kind": "Length",
            "value": 50.0,
            "description": "First / last joint fastener from the joint ends (at most a quarter of the joint)",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "joint_max_spacing",
            "kind": "Length",
            "value": 250.0,
            "description": "Largest joint fastener spacing",
            "lowerBound": 1.0,
            "integer": false
          },
          {
            "name": "overlay_outer",
            "kind": "Length",
            "expression": "thickness - front_reveal",
            "description": "Full overlay: how far a front covers an outer carcass panel",
            "integer": false
          },
          {
            "name": "overlay_shared",
            "kind": "Length",
            "expression": "thickness / 2 - front_gap / 2",
            "description": "How far a front covers a panel shared with a neighbouring front",
            "integer": false
          },
          {
            "name": "plinth_height",
            "kind": "Length",
            "value": 80.0,
            "description": "Height of the plinth / feet space below the carcass",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "plinth_setback",
            "kind": "Length",
            "value": 50.0,
            "description": "Plinth panel front face behind the carcass front",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "rail_width",
            "kind": "Length",
            "value": 100.0,
            "description": "Width of the stretcher rails",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "shelf_clearance",
            "kind": "Length",
            "value": 1.0,
            "description": "Clearance between an adjustable shelf and each supporting panel",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "shelf_depth",
            "kind": "Length",
            "expression": "interior_depth - shelf_setback",
            "description": "Depth (part width) of adjustable shelves",
            "integer": false
          },
          {
            "name": "shelf_pin_back",
            "kind": "Length",
            "value": 50.0,
            "description": "Rear shelf pin in front of the shelf rear edge",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "shelf_pin_front",
            "kind": "Length",
            "value": 50.0,
            "description": "Front shelf pin behind the shelf front edge",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "shelf_setback",
            "kind": "Length",
            "value": 20.0,
            "description": "Adjustable shelf front edge behind the carcass front",
            "lowerBound": 0.0,
            "integer": false
          },
          {
            "name": "side_bottom",
            "kind": "Length",
            "expression": "0",
            "description": "Height of the lower end of the sides",
            "integer": false
          },
          {
            "name": "side_height",
            "kind": "Length",
            "expression": "side_top - side_bottom",
            "description": "Length of the sides",
            "integer": false
          },
          {
            "name": "side_top",
            "kind": "Length",
            "expression": "height",
            "description": "Height of the upper end of the sides",
            "integer": false
          },
          {
            "name": "thickness",
            "kind": "Length",
            "value": 18.0,
            "description": "Carcass board thickness (synchronised from the carcass material)",
            "lowerBound": 1.0,
            "integer": false
          },
          {
            "name": "top_length",
            "kind": "Length",
            "expression": "inner_width",
            "description": "Length of the top panel / rails",
            "integer": false
          },
          {
            "name": "top_x",
            "kind": "Length",
            "expression": "thickness",
            "description": "Left end of the top panel / rails",
            "integer": false
          },
          {
            "name": "width",
            "kind": "Length",
            "value": 1800.0,
            "description": "Overall width",
            "lowerBound": 1.0,
            "integer": false
          }
        ],
        "constraints": [
          {
            "name": "std.back_size",
            "expression": "back_width > 0 && back_height > 0",
            "message": "Back inset {back_inset} mm leaves a back panel of {back_width} x {back_height} mm",
            "severity": "error"
          },
          {
            "name": "std.front_overlay",
            "expression": "overlay_outer >= 0 && overlay_shared >= 0",
            "message": "Front reveal {front_reveal} mm and half the front gap {front_gap} mm must not exceed what a {thickness} mm panel can carry",
            "severity": "error"
          },
          {
            "name": "std.inner_height",
            "expression": "inner_height > 0",
            "message": "Inner height must be positive: height {height} mm leaves {inner_height} mm between the bottom and top panels ({thickness} mm each, carcass starting at {carcass_bottom} mm)",
            "severity": "error"
          },
          {
            "name": "std.inner_width",
            "expression": "inner_width > 0",
            "message": "Inner width must be positive: width {width} mm minus two {thickness} mm sides leaves {inner_width} mm",
            "severity": "error"
          },
          {
            "name": "std.interior_depth",
            "expression": "interior_depth > 0",
            "message": "Interior depth must be positive: depth {depth} mm leaves {interior_depth} mm in front of the back panel",
            "severity": "error"
          },
          {
            "name": "std.plinth",
            "expression": "plinth_height > 0 && plinth_setback + thickness <= depth",
            "message": "Plinth panel needs a height above 0 (is {plinth_height} mm) and setback {plinth_setback} mm plus {thickness} mm within the depth {depth} mm",
            "severity": "error"
          },
          {
            "name": "std.shelf_depth",
            "expression": "shelf_depth > 0",
            "message": "Shelf setback {shelf_setback} mm must be smaller than the interior depth {interior_depth} mm (shelf depth would be {shelf_depth} mm)",
            "severity": "error"
          }
        ],
        "pinnedParameters": [],
        "interior": {
          "size": {
            "kind": "Weight",
            "value": 1.0,
            "expression": ""
          },
          "split": "Vertical",
          "shelfCount": 0,
          "front": {
            "kind": "SlidingDoors",
            "overlay": "Full",
            "hingeSide": "Left",
            "hinges": false,
            "handle": "None",
            "drawerHeights": [],
            "sliding": {
              "count": 2
            }
          },
          "children": [
            {
              "size": {
                "kind": "Weight",
                "value": 1.0,
                "expression": ""
              },
              "split": "None",
              "shelfCount": 4,
              "children": []
            },
            {
              "size": {
                "kind": "Weight",
                "value": 1.0,
                "expression": ""
              },
              "split": "None",
              "shelfCount": 0,
              "hangingRail": {
                "heightFromTop": 60.0
              },
              "children": []
            }
          ]
        }
      }
    ],
    "drawingEdits": {},
    "cutting": {
      "defaults": {
        "kerf": 4.0,
        "trim": {
          "left": 10.0,
          "right": 10.0,
          "top": 10.0,
          "bottom": 10.0
        },
        "minRemnantLength": 300.0,
        "minRemnantWidth": 100.0,
        "maxStages": 0,
        "firstCut": "free",
        "objective": "minimize_sheets",
        "remnants": []
      },
      "materials": {}
    },
    "settings": {
      "backupCount": 3,
      "edgeBanding": {
        "overhangPerEnd": 25.0,
        "wastePercent": 0.0
      },
      "cutListGroupAcrossAssemblies": true
    },
    "custom": {}
  }
}
