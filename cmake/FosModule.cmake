function(fos_set_warnings target scope)
    if(MSVC)
        target_compile_options(${target} ${scope} /W4 /permissive- /utf-8)
        if(FOS_WERROR)
            target_compile_options(${target} ${scope} /WX)
        endif()
    else()
        target_compile_options(${target} ${scope} -Wall -Wextra -Wpedantic -Wshadow -Wconversion
                                                  -Wno-sign-conversion)
        if(FOS_WERROR)
            target_compile_options(${target} ${scope} -Werror)
        endif()
    endif()
endfunction()

# fos_add_module(<name> [SOURCES a.cpp ...] [DEPS fos::core ...] [PRIVATE_DEPS ...])
# Creates library target fos_<name> with alias fos::<name>. Public headers live in
# src/<name>/include/fos/<name>/. A module without SOURCES is header-only.
function(fos_add_module name)
    cmake_parse_arguments(ARG "" "" "SOURCES;DEPS;PRIVATE_DEPS" ${ARGN})
    set(target fos_${name})
    if(ARG_SOURCES)
        add_library(${target} STATIC ${ARG_SOURCES})
        target_include_directories(${target} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
        target_link_libraries(${target} PUBLIC ${ARG_DEPS} PRIVATE ${ARG_PRIVATE_DEPS})
        fos_set_warnings(${target} PRIVATE)
    else()
        add_library(${target} INTERFACE)
        target_include_directories(${target} INTERFACE ${CMAKE_CURRENT_SOURCE_DIR}/include)
        target_link_libraries(${target} INTERFACE ${ARG_DEPS})
    endif()
    add_library(fos::${name} ALIAS ${target})
endfunction()

# fos_add_tests(<name> SOURCES t1.cpp ... [DEPS ...])
# Creates test executable fos_<name>_tests linked to fos::<name> and GoogleTest.
function(fos_add_tests name)
    if(NOT FOS_BUILD_TESTS)
        return()
    endif()
    cmake_parse_arguments(ARG "" "" "SOURCES;DEPS" ${ARGN})
    set(target fos_${name}_tests)
    add_executable(${target} ${ARG_SOURCES})
    set(_self "")
    if(TARGET fos_${name})
        set(_self fos::${name})
    endif()
    target_link_libraries(${target} PRIVATE ${_self} ${ARG_DEPS} GTest::gtest GTest::gmock GTest::gtest_main)
    fos_set_warnings(${target} PRIVATE)
    gtest_discover_tests(${target} DISCOVERY_TIMEOUT 60)
endfunction()
